{
  "key": "",
  "name": "Wisenet Camera/NVR Player Extension with IP Installer",
  "description": "Wisenet Camera/NVR Player Extension with IP Installer",
  "version": "0.4",
  "manifest_version": 3,
  "minimum_chrome_version": "116",
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Wisenet IP Installer",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-128.png",
      "128": "icons/icon-128.png"
    }
  },
  "permissions": [
    "nativeMessaging",
    "storage",
    "clipboardRead",
    "notifications",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "externally_connectable": {
    "ids": ["*"],
    "matches": ["http://my.localhost/*"],
    "accepts_tls_channel_id": false
  },
  "icons": { "16": "icons/icon-16.png", "36": "icons/icon-128.png", "48": "icons/icon-128.png", "128": "icons/icon-128.png", "512": "icons/icon-512.png" },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}

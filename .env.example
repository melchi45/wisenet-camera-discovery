# Copy this file to .env in the same directory you'll run the example
# server FROM (repo root for `npm run start:server`, or dist/nodejs/ if
# you cd there — see README.md's "Example server" section for both
# workflows). It's loaded automatically by
# src/nodejs/examples/loadEnv.ts before the server reads any port config
# — no need to `export` anything in your shell first. Real env vars
# already set always take priority over values here.
#
# Uncomment/edit only the lines you actually want to override; both of
# these already have a working default (see src/nodejs/examples/server.ts).

# HTTP port the example server listens on (PORT is accepted as a fallback
# alias for this).
#HTTP_PORT=8080

# HTTPS port the example server listens on, once its self-signed dev cert
# is generated (see server.ts's ensureSelfSignedCert).
#HTTPS_PORT=8443
